#!/usr/bin/env bash
# parley-axi: a mail client for agents. One GitHub issue in a shared inbox repo is one message.
# The inbox repo's .parley.json names the members and the label scheme; the local config
# (XDG config dir) remembers which inboxes you use and who you are in each.
# Needs bash 3.2+, jq, flock and an authenticated gh. Run `parley-axi --help` or `parley-axi <command> --help`.
set -euo pipefail

CONF=${XDG_CONFIG_HOME:-$HOME/.config}/parley-axi/config.json
CONFIG_FILE=.parley.json
INIT_BRANCH=parley-init
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/parley-axi
OVERLAP=${PARLEY_OVERLAP:-600}
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Defaults merged under the repo's config; jq's `*` merges nested objects.
DEFAULTS='{"labels":{"to":"to:","from":"from:","status":"status:","unread":"unread:",
  "statuses":{"open":"open","acknowledged":"acknowledged","done":"done","declined":"declined"},
  "colors":{"to":"1d76db","from":"5319e7","status":"fbca04","unread":"d93f0b"}}}'

die() { echo "parley-axi: $*" >&2; exit 1; }

help_for() {
  case $1 in
    init) cat <<'EOF'
usage: parley-axi init --repo <owner/name> [--member <id>[:<github-login>[:<Display Name>]]]... [--direct]
Writes a starter .parley.json to the inbox repo and creates every label it defines. Idempotent:
an existing .parley.json is kept as is, an open init PR is reused, and labels are created or updated.
Default: opens a PR from branch parley-init. --direct: commits straight to the default branch.
Without --member, the starter config has one member: your gh login.
EOF
    ;;
    setup) cat <<'EOF'
usage: parley-axi setup --repo <owner/name> --as <member-id> [--name <inbox>] [--default]
Saves an inbox to the local config after checking that you are a member and that every label exists.
--name defaults to the repo name. The first inbox you set up becomes the default; --default switches it.
EOF
    ;;
    inboxes) echo "usage: parley-axi inboxes [--json]   Lists the configured inboxes: name repo member (* marks the default)." ;;
    send) cat <<'EOF'
usage: parley-axi send --to <member-id> --subject <s> [--body <text>|--body-file <file|->] [--link <url>]... [--due YYYY-MM-DD] [--json]
Creates one issue labelled with to, from and open-status. Readers reconcile unread labels.
Body text comes first, then links and due date.
EOF
    ;;
    list) cat <<'EOF'
usage: parley-axi list [--all] [--sent] [--unread] [--json]
Default: open messages addressed to you. --sent: messages you sent. --all: include closed ones.
--unread: cached unread from the latest sync/show, including sent and closed threads; does not mark read.
Run sync to refresh unread before listing; unread listing itself makes no GitHub calls.
Only new messages, new comments and other-party status transitions mark unread; edits do not.
Unread labels in list/show tell the sender who has not read the latest activity.
Lines: #number from:<who> <status> <age> "subject" url   (--sent shows to:<who>)
--json: [{number,subject,from,to,status,unread,unreadFrom,state,comments,createdAt,updatedAt,url}], newest update first.
status is the lifecycle state (open, acknowledged, done, declined), or none/conflict/unknown when the labels are broken.
EOF
    ;;
    show) echo "usage: parley-axi show <n> [--json]   Prints the message header, body and comments, then clears your unread marker. Inconsistent metadata/activity retries once, then fails without saving that observation. Edits do not mark unread. Sender or recipient only." ;;
    reply) echo "usage: parley-axi reply <n> <text>|-   Adds a comment; the other party detects unread activity on sync. '-' reads stdin. Sender or recipient only." ;;
    ack) echo "usage: parley-axi ack <n>   Recipient only. open -> acknowledged." ;;
    done) echo "usage: parley-axi done <n> [note]   Sender or recipient. open|acknowledged -> done, closes the issue. Either party should mark done when nothing actionable is left: the question answered and applied, or the request fulfilled." ;;
    decline) echo "usage: parley-axi decline <n> <reason>   Recipient only. open|acknowledged -> declined, closes the issue." ;;
    reopen) echo "usage: parley-axi reopen <n> [note]   Sender or recipient. done|declined -> open, reopens the issue." ;;
    schedule) cat <<'EOF'
usage: parley-axi schedule install [--every <interval>] --notify '<command>'
       parley-axi schedule status | schedule remove
Installs a systemd user timer where available, otherwise a crontab entry, for this inbox/member.
--every: positive integer with s, m, h or d (default 5m). Cron supports intervals dividing an hour
in whole minutes, or a day in whole hours (e.g. 5m, 15m, 1h, 1d).
Each tick syncs and invokes the shell command only for unread-to-you messages, even on sent or
closed threads. The one-line summary is passed on stdin. No tick output.
Unread repeats until show clears it. Failed notification does not commit the pending sync.
status shows the backend and interval; remove removes only this inbox/member's schedule.
EOF
    ;;
    sync) cat <<'EOT'
usage: parley-axi sync [--json] [--no-commit] | sync --commit | sync --verify [--json]
Delivers every message to you that is new or changed since the last sync (new message, new comments,
status change, edit), at least once. One list query; only changed threads need unread detail queries.
Edits can be delivered but do not mark unread. Stores unread results for list --unread, check and heartbeat. One line per event, or --json: [{...message, event, changes}].
--no-commit prints the events but keeps them pending; sync --commit marks them delivered. Use the pair
when something else has to show the events first, so a crash in between delivers them again.
--verify compares the local delivery state with the repo and lists any message never surfaced and any
broken status; it changes nothing and exits 1 when it finds a problem.
env: PARLEY_OVERLAP (seconds re-read before the cursor, default 600), XDG_STATE_HOME (state in $XDG_STATE_HOME/parley-axi/)
EOT
    ;;
    *) cat <<'EOF'
usage: parley-axi [--inbox <name>] [--as <member-id>] <command> [args]
commands:
  init      write a starter .parley.json to an inbox repo and create its labels
  setup     add an inbox to the local config
  inboxes   list configured inboxes
  send      send a message
  list      list messages to you (or --sent)
  show      read one message
  reply     comment on a message
  ack       acknowledge a message sent to you
  done      sender or recipient: close a message when nothing actionable is left
  decline   decline a message and close it
  reopen    reopen a done or declined message
  sync      deliver new and changed messages, at least once (--verify to reconcile)
  schedule  install, inspect or remove an unread heartbeat
Every command takes --help. --inbox and --as also work after the command.
env: PARLEY_INBOX (inbox name), XDG_CONFIG_HOME (local config at $XDG_CONFIG_HOME/parley-axi/config.json)
EOF
    ;;
  esac
}

# parse <command> <allowed options> <args...>: options land in F_<name> (arrays for --link and --member),
# everything else in POS. --inbox and --as are allowed everywhere; `--` ends options.
parse() {
  local cmd=$1 allowed=" $2 --inbox --as " opt
  shift 2
  POS=()
  while [ $# -gt 0 ]; do
    case $1 in
      --) shift; POS+=("$@"); break ;;
      -h|--help) help_for "$cmd"; exit 0 ;;
      --*)
        [[ $allowed == *" $1 "* ]] || die "$cmd: unknown option '$1' (see parley-axi $cmd --help)"
        opt=${1#--}
        case $1 in
          --json|--all|--sent|--unread|--direct|--default|--verify|--no-commit|--commit) printf -v "F_${opt//-/_}" 1; shift; continue ;;
        esac
        [ $# -ge 2 ] || die "$cmd: $1 needs a value"
        case $1 in
          --link) F_link+=("$2") ;;
          --member) F_member+=("$2") ;;
          *) printf -v "F_${opt//-/_}" '%s' "$2" ;;
        esac
        shift 2
        ;;
      *) POS+=("$1"); shift ;;
    esac
  done
}
F_inbox="" F_as="" F_repo="" F_name="" F_to="" F_subject="" F_body="" F_body_file="" F_due=""
F_json="" F_all="" F_sent="" F_unread="" F_direct="" F_default="" F_verify="" F_no_commit="" F_commit=""
F_every="5m" F_notify=""
F_link=() F_member=()

require_gh() {
  command -v jq >/dev/null || die "jq is not installed"
  command -v gh >/dev/null || die "gh is not installed"
  gh auth token >/dev/null 2>&1 || die "gh is not authenticated: run 'gh auth login'"
}

check_repo() { [[ $1 =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "--repo must look like owner/name, got '$1'"; }

# fetch_config: sets RAW to the repo's .parley.json, or returns 1 when the file does not exist.
fetch_config() {
  if RAW=$(gh api -H 'Accept: application/vnd.github.raw+json' "repos/$REPO/contents/$CONFIG_FILE" 2>&1); then return 0; fi
  case $RAW in *"HTTP 404"*) return 1 ;; esac
  die "gh failed reading $REPO/$CONFIG_FILE: $RAW"
}

# use_config <json>: validates it, then sets CFG (defaults merged), the label prefixes P_* and status values S_*.
use_config() {
  local err
  CFG=$(jq -c --argjson d "$DEFAULTS" '$d * .' <<<"$1" 2>/dev/null) || die "$REPO/$CONFIG_FILE is not a JSON object"
  err=$(jq -r 'def nonempty: type == "string" and . != "";
    [ (if (.members | type) != "array" or (.members | length) == 0 then "members must be a non-empty array"
       else (.members[] | if type != "object" then "each member must be an object"
         elif (.id | type) != "string" or (.id | test("^[A-Za-z0-9._-]+$") | not) then "member id \(.id | tojson) must match [A-Za-z0-9._-]+"
         elif (.github | nonempty | not) then "member \(.id) needs a github login" else empty end),
         (.members | map(.id) | group_by(.)[] | select(length > 1) | "duplicate member id \(.[0])") end),
      (if ([.labels.to, .labels.from, .labels.status, .labels.unread] | all(nonempty) | not) then "labels.to, labels.from, labels.status and labels.unread must be non-empty strings"
       else [.labels.to, .labels.from, .labels.status, .labels.unread] as $prefixes |
         if any(range(0;4); . as $i | any(range(0;4); . as $j |
           $i != $j and ($prefixes[$i] | startswith($prefixes[$j]))))
         then "labels.to, labels.from, labels.status and labels.unread must differ and not overlap" else empty end end),
      (if ([.labels.statuses | .open, .acknowledged, .done, .declined] | all(nonempty) | not) then "labels.statuses needs open, acknowledged, done and declined"
       elif ([.labels.statuses | .open, .acknowledged, .done, .declined] | unique | length) != 4 then "labels.statuses values must differ" else empty end)
    ] | first // empty' <<<"$CFG" 2>/dev/null) || die "$REPO/$CONFIG_FILE has an invalid shape"
  [ -z "$err" ] || die "$REPO/$CONFIG_FILE: $err"
  eval "$(jq -r '.labels | @sh "P_TO=\(.to) P_FROM=\(.from) P_ST=\(.status) P_UNREAD=\(.unread) S_OPEN=\(.statuses.open) S_ACK=\(.statuses.acknowledged) S_DONE=\(.statuses.done) S_DECL=\(.statuses.declined)"' <<<"$CFG")"
}

is_member() { jq -e --arg id "$1" 'any(.members[]; .id == $id)' <<<"$CFG" >/dev/null; }
member_ids() { jq -r '[.members[].id] | join(", ")' <<<"$CFG"; }

# labels_tsv: every label the config defines, as name<TAB>color<TAB>description.
labels_tsv() {
  jq -r '.labels as $l | ($l.colors | map_values(tostring | ltrimstr("#"))) as $c |
    (.members[] | [$l.to + .id, $c.to, "Message to \(.name // .id)"], [$l.from + .id, $c.from, "Message from \(.name // .id)"]),
    ($l.statuses | (.open, .acknowledged, .done, .declined) | [$l.status + ., $c.status, "Message status: \(.)"]) | @tsv' <<<"$CFG"
}

# resolve: picks the inbox (--inbox, PARLEY_INBOX, then the default), sets INBOX, REPO, ME and loads the repo config.
resolve_local() {
  [ -f "$CONF" ] || die "no inbox configured: run parley-axi setup --repo <owner/name> --as <member-id>"
  INBOX=${F_inbox:-${PARLEY_INBOX:-$(jq -r '.default // empty' "$CONF")}}
  [ -n "$INBOX" ] || die "no default inbox: pass --inbox <name> (see parley-axi inboxes)"
  REPO=$(jq -r --arg n "$INBOX" '.inboxes[$n].repo // empty' "$CONF")
  [ -n "$REPO" ] || die "unknown inbox '$INBOX' (see parley-axi inboxes)"
  ME=${F_as:-$(jq -r --arg n "$INBOX" '.inboxes[$n].member // empty' "$CONF")}
  [[ $INBOX =~ ^[A-Za-z0-9._-]+$ && $ME =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid inbox or member id"
  case $INBOX:$ME in .:*|..:*|*:.|*:..) die "inbox and member ids cannot be '.' or '..'" ;; esac
}

resolve() {
  resolve_local
  require_gh
  fetch_config || die "$REPO has no $CONFIG_FILE: run parley-axi init --repo $REPO"
  use_config "$RAW"
  is_member "$ME" || die "'$ME' is not a member of $REPO (members: $(member_ids))"
}


# load <n>: sets STATE and LABELS (one per line) and checks it is a parley message.
load() {
  [[ $1 =~ ^[0-9]+$ ]] || die "message number must be numeric, got '$1'"
  local out
  out=$(gh issue view "$1" -R "$REPO" --json state,labels --jq '.state, .labels[].name' 2>&1) || case $out in
    *"Could not resolve"*|*"not found"*) die "no message #$1 in $REPO" ;;
    *) die "gh failed reading #$1: $out" ;;
  esac
  STATE=$(head -n 1 <<<"$out")
  LABELS=$(tail -n +2 <<<"$out")
  [ -n "$(label_val "$P_FROM")" ] || die "#$1 is not a parley message (no $P_FROM label)"
}

# label_val <prefix>: the rest of the first LABELS entry that starts with <prefix>.
label_val() {
  local l
  while IFS= read -r l; do
    if [[ $l == "$1"* ]]; then echo "${l#"$1"}"; return 0; fi
  done <<<"$LABELS"
}

need_party() {
  case $ME in "$(label_val "$P_TO")"|"$(label_val "$P_FROM")") ;;
    *) die "#$1 is between $(label_val "$P_FROM") and $(label_val "$P_TO"), not you ($ME)" ;;
  esac
}

need_recipient() {
  [ "$(label_val "$P_TO")" = "$ME" ] || die "#$1 is addressed to $(label_val "$P_TO"), not to you ($ME)"
}

status_label() {
  case $1 in open) echo "$P_ST$S_OPEN" ;; acknowledged) echo "$P_ST$S_ACK" ;; done) echo "$P_ST$S_DONE" ;; declined) echo "$P_ST$S_DECL" ;; esac
}

# cur_status <n>: the message's lifecycle state. The single status label is the state; open/closed follows it.
cur_status() {
  local l vals=()
  while IFS= read -r l; do
    if [[ $l == "$P_ST"* ]]; then vals+=("${l#"$P_ST"}"); fi
  done <<<"$LABELS"
  [ ${#vals[@]} -eq 1 ] || die "#$1 has ${#vals[@]} status labels: fix them by hand so exactly one remains (see parley-axi sync --verify)"
  case ${vals[0]} in
    "$S_OPEN") echo open ;; "$S_ACK") echo acknowledged ;; "$S_DONE") echo "done" ;; "$S_DECL") echo declined ;;
    *) die "#$1 has unknown status label '$P_ST${vals[0]}'" ;;
  esac
}

ensure_unread_label() {
  local color
  color=$(jq -r '.labels.colors.unread | ltrimstr("#")' <<<"$CFG")
  gh label create "$P_UNREAD$1" -R "$REPO" --color "$color" \
    --description "Unread for $1" --force >/dev/null
}

# set_status <n> <label>: leaves exactly one status label on the issue.
set_status() {
  local args=(--add-label "$2") l
  while IFS= read -r l; do
    if [[ $l == "$P_ST"* && $l != "$2" ]]; then args+=(--remove-label "$l"); fi
  done <<<"$LABELS"
  gh issue edit "$1" -R "$REPO" "${args[@]}" >/dev/null
}

# JQ_NORM: turns a REST issue into a message. status is the lifecycle state, or none/conflict/unknown when the labels are broken.
# shellcheck disable=SC2016 # jq variables
JQ_NORM='def version: {updatedAt, subject, from, to, status, state, comments, body};
  def newer($old): $old == null or .updatedAt > $old.updatedAt or
    (.updatedAt == $old.updatedAt and version != ($old | version));
  def party($me): .from != null and .to != null and (.to == $me or .from == $me);
  def lab($p): [.labels[] | select(startswith($p)) | ltrimstr($p)];
  def norm($l): ($l.statuses | to_entries | map({key: .value, value: .key}) | from_entries) as $roles |
    {number, subject: .title, body, from: (lab($l.from) | first), to: (lab($l.to) | first),
     status: (lab($l.status) | if length == 1 then ($roles[.[0]] // "unknown") elif length == 0 then "none" else "conflict" end),
     unread: lab($l.unread), unreadFrom: (if (lab($l.from) | first) == $me then (lab($l.to) | first) else (lab($l.from) | first) end), state, comments, createdAt: .created_at, updatedAt: .updated_at, url: .html_url};'

# fetch_issues <label> <open|closed|all> [since]: every matching message, all pages, oldest update first, as one JSON array.
fetch_issues() {
  local q
  q="${1:+labels=$(jq -rn --arg l "$1" '$l | @uri')&}state=$2&sort=updated&direction=asc&per_page=100${3:+&since=$3}"
  gh api --paginate "repos/$REPO/issues?$q" \
    --jq '.[] | select(.pull_request == null) | {number, title, body, state, comments, created_at, updated_at, html_url, labels: [.labels[].name]}' |
    jq -cs --arg me "$ME" --argjson l "$(jq -c .labels <<<"$CFG")" "$JQ_NORM map(norm(\$l))"
}

fetch_thread() {
  local n=$1 thread comments timeline login attempt
  login=$(jq -r --arg me "$ME" '.members[] | select(.id == $me) | .github | ascii_downcase' <<<"$CFG")
  for attempt in 1 2; do
    thread=$(gh api graphql -f owner="${REPO%/*}" -f name="${REPO#*/}" -F number="$n" -f query="$(cat <<'GRAPHQL'
      query($owner:String!, $name:String!, $number:Int!) {
        repository(owner:$owner,name:$name) { issue(number:$number) {
          id number title body state createdAt updatedAt url author { login }
          labels(first:100) { nodes { name } }
        } }
      }
GRAPHQL
)" | jq -ce '.data.repository.issue | select(.id != null) | .labels = .labels.nodes |
      .activity = [{id, actor: .author.login}]') || return 1
    timeline=$(gh api graphql --paginate -f owner="${REPO%/*}" -f name="${REPO#*/}" -F number="$n" -f query="$(cat <<'GRAPHQL'
      query($owner:String!, $name:String!, $number:Int!, $endCursor:String) {
        repository(owner:$owner,name:$name) { issue(number:$number) {
          updatedAt
          timelineItems(first:100,after:$endCursor,itemTypes:[CLOSED_EVENT,REOPENED_EVENT,LABELED_EVENT,UNLABELED_EVENT]) {
            pageInfo { hasNextPage endCursor } nodes {
              __typename
              ... on ClosedEvent { id actor { login } }
              ... on ReopenedEvent { id actor { login } }
              ... on LabeledEvent { id actor { login } label { name } }
              ... on UnlabeledEvent { id actor { login } label { name } }
            }
          }
        } }
      }
GRAPHQL
)") || return 1
    if timeline=$(jq -ces --arg updated "$(jq -r .updatedAt <<<"$thread")" --arg st "$P_ST" '
      select(all(.[]; .data.repository.issue.updatedAt == $updated)) |
      [.[].data.repository.issue.timelineItems.nodes[] |
        select(.label == null or (.label.name | startswith($st))) | {id, actor: .actor.login}]' <<<"$timeline"); then
      break
    elif [ "$attempt" = 2 ]; then
      echo "parley-axi: #$n changed while fetching activity; observation not saved" >&2
      return 1
    fi
  done
  comments=$(gh api graphql --paginate -f owner="${REPO%/*}" -f name="${REPO#*/}" -F number="$n" -f query="$(cat <<'GRAPHQL'
    query($owner:String!, $name:String!, $number:Int!, $endCursor:String) {
      repository(owner:$owner,name:$name) { issue(number:$number) {
        comments(first:100,after:$endCursor) {
          pageInfo { hasNextPage endCursor }
          nodes { id body createdAt updatedAt author { login } }
        }
      } }
    }
GRAPHQL
)" | jq -cs '[.[].data.repository.issue.comments.nodes[]]') || return 1
  jq -c --slurpfile comments <(printf '%s\n' "$comments") --slurpfile timeline <(printf '%s\n' "$timeline") --arg login "$login" '
    .activity = ([.activity[], ($comments[0][] | {id, actor: .author.login}), $timeline[0][]] |
      map(select((.actor // "" | ascii_downcase) != $login) | .id) | unique) |
    .comments = $comments[0]' <<<"$thread"
}

thread_message() {
  jq -c --arg me "$ME" --slurpfile cfg <(printf '%s\n' "$CFG") "$JQ_NORM
    . as \$thread | .labels |= map(.name) | .comments = (.comments | length) |
    .created_at = .createdAt | .updated_at = .updatedAt | .html_url = .url | .state |= ascii_downcase |
    norm(\$cfg[0].labels) + {activity: \$thread.activity}"
}

publish_unread() {
  local message=$1 n unread marked
  n=$(jq -er .number <<<"$message") || return 1
  unread=$(jq -r --arg n "$n" --slurpfile read "$D/read.json" --slurpfile cache "$D/activity.json" \
    '(($cache[0].versions[$n].activity // []) - ($read[0][$n] // []) | length) > 0' <<<"$message") || return 1
  marked=$(jq -r --arg me "$ME" '.unread | index($me) != null' <<<"$message") || return 1
  if [ "$unread" != "$marked" ]; then
    if [ "$unread" = true ]; then
      ensure_unread_label "$ME" || return 1
      gh issue edit "$n" -R "$REPO" --add-label "$P_UNREAD$ME" >/dev/null || return 1
    else
      gh issue edit "$n" -R "$REPO" --remove-label "$P_UNREAD$ME" >/dev/null || return 1
    fi
  fi
  jq -c --arg n "$n" --arg me "$ME" --argjson unread "$unread" '
    if .versions[$n] != null then .versions[$n].message.unread |=
      ((. - [$me]) + if $unread then [$me] else [] end) else . end' "$D/activity.json" |
    state_write "$D/activity.json"
}

state_lock() {
  command -v flock >/dev/null || die "flock is required for local state locking"
  check_repo "$REPO"
  D="$STATE_DIR/$INBOX/$ME/$(tr '[:upper:]' '[:lower:]' <<<"${REPO/\//:}")"
  mkdir -p "$D"
  exec 8>"$D/state.lock"
  flock 8
  local file
  for file in read state activity; do
    if [ ! -f "$D/$file.json" ]; then echo '{}' > "$D/$file.json"; fi
  done
}

state_write() {
  local tmp
  tmp=$(mktemp "$1.XXXXXX") || return 1
  if cat > "$tmp" && jq -e 'type == "object"' "$tmp" >/dev/null && mv "$tmp" "$1"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

cache_thread() {
  jq -c --arg me "$ME" --slurpfile old "$D/activity.json" --slurpfile source <(printf '%s\n' "$1") "$JQ_NORM
    . as \$thread | \$old[0] | (\$thread.number | tostring) as \$key |
    if \$thread.updatedAt < \$source[0].updatedAt or
      (\$thread.updatedAt == \$source[0].updatedAt and (\$thread | version) != (\$source[0] | version))
      then error(\"issue changed while fetching details\")
    elif .versions[\$key] != null and \$source[0].updatedAt < .versions[\$key].version.updatedAt then .
    elif (\$thread | party(\$me) | not) then del(.versions[\$key])
    else .versions[\$key] = {version: (\$source[0] | version), activity: \$thread.activity,
      message: (\$thread | del(.activity, .body))} end" |
    state_write "$D/activity.json"
}

reconcile_updates() {
  local n changed source thread candidates
  jq -c --arg me "$ME" --slurpfile issues <(printf '%s\n' "$1") "$JQ_NORM
    reduce \$issues[0][] as \$issue (.; (\$issue.number | tostring) as \$key |
      .versions[\$key].version as \$known |
      if (\$issue | party(\$me) | not) and (\$issue | newer(\$known)) then
        del(.versions[\$key]) else . end)" "$D/activity.json" | state_write "$D/activity.json"
  candidates=$(jq -r --arg me "$ME" --slurpfile old "$D/activity.json" --slurpfile read "$D/read.json" "$JQ_NORM
    .[] | (.number | tostring) as \$key | \$old[0].versions[\$key] as \$known |
    ((\$known.activity // []) - (\$read[0][\$key] // []) | length > 0) as \$unread |
    (party(\$me) and newer(\$known.version)) as \$changed |
    select(\$changed or ((.unread | index(\$me) != null) != \$unread)) |
    [.number, \$changed] | @tsv" <<<"$1") || return 1
  while IFS=$'\t' read -r n changed; do
    [ -n "$n" ] || continue
    source=$(jq -c --argjson n "$n" '.[] | select(.number == $n)' <<<"$1") || return 1
    if [ "$changed" = true ]; then
      thread=$(fetch_thread "$n" | thread_message) || return 1
      printf '%s\n' "$thread" | cache_thread "$source" || return 1
      publish_unread "$thread" || return 1
    else
      publish_unread "$source" || return 1
    fi
  done <<<"$candidates"
  candidates=$(jq -c --arg me "$ME" --slurpfile read "$D/read.json" '
    .versions[]? | select(((.activity - ($read[0][.message.number | tostring] // []) | length) > 0) !=
      (.message.unread | index($me) != null)) | .message' "$D/activity.json") || return 1
  while IFS= read -r source; do
    [ -n "$source" ] || continue
    publish_unread "$source" || return 1
  done <<<"$candidates"
  jq -c --slurpfile issues <(printf '%s\n' "$1") \
    '.cursor = ([.cursor // empty, $issues[0][].updatedAt] | max)' "$D/activity.json" |
    state_write "$D/activity.json"
}

# crashpoint <step>: test hook that simulates a crash right before <step>.
crashpoint() { [ "${PARLEY_CRASH_AT:-}" != "$1" ] || exit 70; }
cmd_init() {
  parse init "--repo --member --direct" "$@"
  if [ ${#POS[@]} -ne 0 ] || [ -z "$F_repo" ]; then
    die "usage: parley-axi init --repo <owner/name> (see --help)"
  fi
  check_repo "$F_repo"
  REPO=$F_repo
  require_gh
  if fetch_config; then
    use_config "$RAW"
    echo "config: $REPO/$CONFIG_FILE exists, kept it"
  else
    local m id gh_login name members="[]" json b64 branch sha url
    if [ ${#F_member[@]} -eq 0 ]; then F_member=("$(gh api user --jq .login)"); fi
    for m in "${F_member[@]}"; do
      IFS=: read -r id gh_login name <<<"$m"
      members=$(jq -c --arg i "$id" --arg g "${gh_login:-$id}" --arg n "${name:-$id}" '. + [{id: $i, name: $n, github: $g}]' <<<"$members")
    done
    json=$(jq --argjson m "$members" --argjson d "$DEFAULTS" -n '{members: $m} + $d')
    use_config "$json"
    b64=$(printf '%s\n' "$json" | base64 | tr -d '\n')
    if [ -n "$F_direct" ]; then
      gh api -X PUT "repos/$REPO/contents/$CONFIG_FILE" -f message="chore: add parley inbox config" -f content="$b64" >/dev/null
      echo "config: committed $CONFIG_FILE to $REPO"
    elif url=$(gh pr list -R "$REPO" --head "$INIT_BRANCH" --state open --json url --jq '.[0].url // empty') && [ -n "$url" ]; then
      echo "config: init PR already open: $url (merge it, then run parley-axi setup)"
    else
      branch=$(gh api "repos/$REPO" --jq .default_branch)
      sha=$(gh api "repos/$REPO/git/ref/heads/$branch" --jq .object.sha 2>/dev/null) \
        || die "cannot read $REPO@$branch (empty repo?): rerun with --direct"
      gh api "repos/$REPO/git/refs" -f ref="refs/heads/$INIT_BRANCH" -f sha="$sha" >/dev/null 2>&1 \
        || die "cannot create branch $INIT_BRANCH in $REPO (it may already exist without an open PR): delete it or rerun with --direct"
      gh api -X PUT "repos/$REPO/contents/$CONFIG_FILE" -f message="chore: add parley inbox config" -f content="$b64" -f branch="$INIT_BRANCH" >/dev/null
      url=$(gh pr create -R "$REPO" --head "$INIT_BRANCH" --base "$branch" --title "Add parley inbox config" \
        --body "Adds $CONFIG_FILE so parley-axi can use this repo as an inbox. Edit the members before merging.")
      echo "config: opened $url (merge it, then run parley-axi setup)"
    fi
  fi
  local n=0 label color desc
  while IFS=$'\t' read -r label color desc; do
    gh label create "$label" -R "$REPO" --color "$color" --description "$desc" --force >/dev/null
    n=$((n + 1))
  done < <(labels_tsv)
  echo "labels: $n ensured in $REPO"
}

cmd_setup() {
  parse setup "--repo --name --default" "$@"
  if [ ${#POS[@]} -ne 0 ] || [ -z "$F_repo" ] || [ -z "$F_as" ]; then
    die "usage: parley-axi setup --repo <owner/name> --as <member-id> (see --help)"
  fi
  check_repo "$F_repo"
  REPO=$F_repo ME=$F_as
  local name=${F_name:-${F_repo#*/}} have missing login want
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "--name must match [A-Za-z0-9._-]+, got '$name'"
  require_gh
  fetch_config || die "$REPO has no $CONFIG_FILE: run parley-axi init --repo $REPO"
  use_config "$RAW"
  is_member "$ME" || die "'$ME' is not a member of $REPO (members: $(member_ids))"
  have=$(gh label list -R "$REPO" --limit 1000 --json name --jq '.[].name') || die "gh failed listing labels in $REPO"
  missing=$(labels_tsv | cut -f1 | grep -vxF -f <(printf '%s\n' "$have") | paste -sd' ' -) || true
  [ -z "$missing" ] || die "missing labels in $REPO: $missing (run parley-axi init --repo $REPO)"
  want=$(jq -r --arg id "$ME" '.members[] | select(.id == $id) | .github' <<<"$CFG")
  login=$(gh api user --jq .login 2>/dev/null) || login=""
  if [ -n "$login" ] && [ "$(tr '[:upper:]' '[:lower:]' <<<"$login")" != "$(tr '[:upper:]' '[:lower:]' <<<"$want")" ]; then
    echo "warning: gh is logged in as $login, but $ME is $want in $REPO" >&2
  fi
  mkdir -p "$(dirname "$CONF")"
  { cat "$CONF" 2>/dev/null || echo '{}'; } | jq --arg n "$name" --arg r "$REPO" --arg m "$ME" --arg d "$F_default" \
    '.inboxes[$n] = {repo: $r, member: $m} | if .default == null or $d == "1" then .default = $n else . end' > "$CONF.tmp"
  mv "$CONF.tmp" "$CONF"
  echo "inbox $name: $REPO as $ME$( [ "$(jq -r .default "$CONF")" = "$name" ] && echo " (default)")"
}

cmd_inboxes() {
  parse inboxes "--json" "$@"
  [ -f "$CONF" ] || { echo "no inboxes (run parley-axi setup)"; return; }
  if [ -n "$F_json" ]; then jq '.' "$CONF"; return; fi
  jq -r '.default as $d | .inboxes | to_entries[] | "\(.key)\(if .key == $d then "*" else "" end) \(.value.repo) \(.value.member)"' "$CONF"
}

cmd_send() {
  parse send "--to --subject --body --body-file --link --due --json" "$@"
  [ ${#POS[@]} -eq 0 ] || die "send: unexpected argument '${POS[0]}' (see parley-axi send --help)"
  local body=$F_body parts=() msg="" p url
  resolve
  [ -n "$F_to" ] || die "send: --to is required (members: $(member_ids))"
  is_member "$F_to" || die "send: '$F_to' is not a member of $REPO (members: $(member_ids))"
  [ -n "$F_subject" ] || die "send: --subject is required"
  if [ -n "$F_body_file" ]; then
    [ -z "$body" ] || die "send: use --body or --body-file, not both"
    if [ "$F_body_file" = - ]; then body=$(cat); else
      [ -r "$F_body_file" ] || die "send: cannot read $F_body_file"
      body=$(cat "$F_body_file")
    fi
  fi
  for p in ${F_link[@]+"${F_link[@]}"}; do
    [[ $p == http://* || $p == https://* ]] || die "send: --link must be an http(s) URL, got '$p'"
  done
  if [ -n "$F_due" ]; then
    [[ $F_due =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "send: --due must be YYYY-MM-DD, got '$F_due'"
  fi

  if [ -n "$body" ]; then parts+=("$body"); fi
  if [ ${#F_link[@]} -gt 0 ]; then parts+=("Links:"$'\n'"$(printf -- '- %s\n' "${F_link[@]}")"); fi
  if [ -n "$F_due" ]; then parts+=("Due: $F_due"); fi
  parts+=("<!-- parley-message {\"v\":1,\"from\":\"$ME\",\"to\":\"$F_to\"} -->")
  for p in "${parts[@]}"; do msg+="${msg:+$'\n\n'}$p"; done

  url=$(gh issue create -R "$REPO" --title "$F_subject" --body "$msg" \
    --label "$P_TO$F_to" --label "$P_FROM$ME" --label "$(status_label open)")
  if [ -n "$F_json" ]; then
    jq -nc --argjson n "${url##*/}" --arg u "$url" --arg t "$F_to" '{number: $n, to: $t, url: $u}'
  else
    echo "sent #${url##*/} to $F_to: $url"
  fi
}

cmd_list() {
  parse list "--all --sent --unread --json" "$@"
  [ ${#POS[@]} -eq 0 ] || die "list: unexpected argument '${POS[0]}' (see parley-axi list --help)"
  local state=open mine show=from out
  if [ -n "$F_unread" ]; then
    resolve_local
    state_lock
    out=$(jq -c --arg me "$ME" --arg sent "$F_sent" --slurpfile read "$D/read.json" "$JQ_NORM"'
      [.versions[]? | . as $thread | .message | select(party($me)) |
        .unread = ((.unread - [$me]) + if ($thread.activity - ($read[0][.number | tostring] // []) | length) > 0 then [$me] else [] end) |
        select(.unread | index($me)) | select($sent == "" or .from == $me)] |
      sort_by(.updatedAt, .number) | reverse' "$D/activity.json")
  else
    resolve
    mine=$P_TO
    if [ -n "$F_all" ]; then state=all; fi
    if [ -n "$F_sent" ]; then mine=$P_FROM; fi
    out=$(fetch_issues "$mine$ME" "$state" | jq -c --arg me "$ME" --arg sent "$F_sent" '
      map(select(.to == $me or .from == $me) | select($sent == "" or .from == $me)) | reverse') \
      || die "gh failed listing messages in $REPO"
  fi
  if [ -n "$F_sent" ]; then show=to; fi
  if [ -n "$F_json" ]; then jq -c 'map(del(.body))' <<<"$out"; return; fi
  out=$(jq -r --arg show "$show" '
    def age: if . < 60 then "\(.)s" elif . < 3600 then "\(./60|floor)m"
             elif . < 86400 then "\(./3600|floor)h" else "\(./86400|floor)d" end;
    .[] | "#\(.number) \($show):\(.[$show] // "-") \(.status) \((now - (.createdAt | fromdateiso8601)) | floor | age) \"\(.subject)\"\(if (.unread | length) > 0 then " unread:" + (.unread | join(",")) else "" end) \(.url)"' <<<"$out")
  echo "${out:-no messages}"
}

cmd_show() {
  parse show "--json" "$@"
  [ ${#POS[@]} -eq 1 ] || die "usage: parley-axi show <n> [--json]"
  resolve
  load "${POS[0]}"
  need_party "${POS[0]}"
  local out rendered
  out=$(fetch_thread "${POS[0]}")
  thread_message <<<"$out" | jq -e --arg me "$ME" "$JQ_NORM party(\$me)" >/dev/null || die "#${POS[0]} is not your message"
  if [ -n "$F_json" ]; then rendered=$(jq -c 'del(.activity)' <<<"$out"); else
  # Rendered here because gh's non-TTY --comments output drops the body.
  rendered=$(jq -r --arg to "$P_TO" --arg from "$P_FROM" --arg st "$P_ST" --arg unread "$P_UNREAD" '
    def lab($p): [.labels[].name | select(startswith($p)) | ltrimstr($p)] | first // "-";
    def text: split("\n") | map(select(startswith("<!-- parley-") | not)) | join("\n") | sub("\\s+$"; "");
    "#\(.number) \(.title)",
    "from:\(lab($from)) to:\(lab($to)) status:\(lab($st)) \(.state | ascii_downcase) \(.createdAt) \(.url)",
    "unread: \([.labels[].name | select(startswith($unread)) | ltrimstr($unread)] | if length == 0 then "none" else join(", ") end)",
    "", (.body | text | select(. != "")),
    (.comments[] | "", "--- \(.author.login) \(.createdAt)", (.body | text))' <<<"$out")
  fi
  printf '%s\n' "$rendered"
  state_lock
  local n=${POS[0]}
  jq -c --arg n "$n" --slurpfile seen <(jq -c .activity <<<"$out") \
    '.[$n] = ((.[$n] // []) + $seen[0] | unique)' "$D/read.json" | state_write "$D/read.json"
  out=$(fetch_thread "$n" | thread_message) || return 1
  printf '%s\n' "$out" | cache_thread "$out"
  publish_unread "$out"

}

cmd_reply() {
  parse reply "" "$@"
  [ ${#POS[@]} -ge 2 ] || die "usage: parley-axi reply <n> <text>|-"
  local n=${POS[0]} text="${POS[*]:1}"
  resolve
  load "$n"
  need_party "$n"
  if [ "$text" = - ]; then text=$(cat); fi
  [ -n "$text" ] || die "reply text is empty"
  gh issue comment "$n" -R "$REPO" --body "$text" >/dev/null
  echo "replied on #$n"
}

# transition <ack|done|decline|reopen> <note>: one step of the message state machine (see README).
# Writes in this order: the record comment, close/reopen, then the status label. The label is the
# commit point, so after a failure the same command is still legal and rerunning it finishes the step.
transition() {
  local cmd=$1 note=$2 n=${POS[0]} cur next body out
  resolve
  load "$n"
  case $cmd in done|reopen) need_party "$n" ;; *) need_recipient "$n" ;; esac
  cur=$(cur_status "$n")
  case $cmd:$cur in
    ack:open) next=acknowledged ;;
    done:open|done:acknowledged) next="done" ;;
    decline:open|decline:acknowledged) next=declined ;;
    reopen:done|reopen:declined) next=open ;;
    *) case $cur in open) out="ack, done or decline" ;; acknowledged) out="done or decline" ;; *) out=reopen ;; esac
       die "$cmd: #$n is $cur; from $cur the allowed commands are $out" ;;
  esac
  body="parley: $cur -> $next by $ME"$'\n'"<!-- parley-transition {\"v\":1,\"from\":\"$cur\",\"to\":\"$next\",\"by\":\"$ME\"} -->"
  if [ -n "$note" ]; then body+=$'\n\n'"$note"; fi
  gh issue comment "$n" -R "$REPO" --body "$body" >/dev/null
  # gh prints its own success line on stderr, so keep stderr only when the call fails
  case $next:$STATE in
    done:OPEN|declined:OPEN) out=$(gh issue close "$n" -R "$REPO" 2>&1) || die "gh failed closing #$n: $out" ;;
    open:CLOSED) out=$(gh issue reopen "$n" -R "$REPO" 2>&1) || die "gh failed reopening #$n: $out" ;;
  esac
  set_status "$n" "$(status_label "$next")"
  echo "#$n $cur -> $next"
}

cmd_ack() {
  parse ack "" "$@"
  [ ${#POS[@]} -eq 1 ] || die "usage: parley-axi ack <n>"
  transition ack ""
}

cmd_done() {
  parse "done" "" "$@"
  [ ${#POS[@]} -ge 1 ] || die "usage: parley-axi done <n> [note]"
  transition "done" "${POS[*]:1}"
}

cmd_decline() {
  parse decline "" "$@"
  [ ${#POS[@]} -ge 2 ] || die "usage: parley-axi decline <n> <reason>"
  transition decline "${POS[*]:1}"
}

cmd_reopen() {
  parse reopen "" "$@"
  [ ${#POS[@]} -ge 1 ] || die "usage: parley-axi reopen <n> [note]"
  transition reopen "${POS[*]:1}"
}

# Delivery state per inbox/member/repo, in $STATE_DIR/<inbox>/<member>/<owner>:<repo>/:
#   state.json    {cursor, versions: {"<n>": {updatedAt, subject, from, to, status, state, comments, body}}}, the last committed delivery
#   pending.json  the next state.json plus the events it delivers, written before any event is printed
# A sync fetches every message updated since cursor minus PARLEY_OVERLAP, prints what changed, and only then
# commits. A crash at any step leaves state.json as it was, so the events come again (at least once).
commit_pending() {
  [ -f "$1/pending.json" ] || return 0
  local tmp
  tmp=$(mktemp "$1/state.json.XXXXXX")
  jq -c 'del(.events)' "$1/pending.json" > "$tmp"
  crashpoint swap
  mv "$tmp" "$1/state.json"
  rm -f "$1/pending.json"
}

cmd_sync() {
  parse sync "--verify --no-commit --commit --json" "$@"
  [ ${#POS[@]} -eq 0 ] || die "sync: unexpected argument '${POS[0]}' (see parley-axi sync --help)"
  resolve_local
  if [ -z "$F_commit" ]; then resolve; fi
  state_lock
  local dir=$D since issues out
  if [ -n "$F_commit" ]; then commit_pending "$dir"; return; fi
  if [ -n "$F_verify" ]; then verify "$dir"; return; fi

  since=$(jq -nr --argjson o "$OVERLAP" --slurpfile delivered "$dir/state.json" --slurpfile activity "$dir/activity.json" '
    if $delivered[0].cursor == null or $activity[0].cursor == null then empty else
      [$delivered[0].cursor, $activity[0].cursor] | min | fromdateiso8601 - $o | todateiso8601 end')
  issues=$(fetch_issues "" all "$since") \
    || die "gh failed fetching messages from $REPO"
  reconcile_updates "$issues"
  crashpoint write-pending
  # A version only moves forward, so a stale read never hides or replays an update. The first sync
  # delivers open messages only; closed ones before it are history, not news.
  jq -c --arg me "$ME" --slurpfile s "$dir/state.json" "$JQ_NORM"'
    . as $fetched | map(select(party($me) and .to == $me)) | $s[0] as $old | ($old.versions // {}) as $v | . as $all |
    {cursor: ([$old.cursor // empty, $fetched[].updatedAt] | max),
     versions: (reduce $all[] as $i ($v; ($i.number | tostring) as $k |
       .[$k] as $known | if ($i | newer($known)) then .[$k] = ($i | version) else . end)),
     events: [$all[] | . as $i | $v[.number | tostring] as $o |
       select(if $o == null then ($old.cursor != null or .state == "open") else newer($o) end) |
       . + {event: (if $o == null then "new" else "updated" end),
            changes: (if $o == null then [] else
              [(if .comments > $o.comments then "+\(.comments - $o.comments) comment(s)" else empty end),
               (if .status != $o.status then "\($o.status) -> \(.status)" else empty end),
               (if .state != $o.state then .state else empty end)] | if length == 0 then ["edited"] else . end end)} | del(.body)]}' \
    <<<"$issues" | state_write "$dir/pending.json"
  crashpoint emit
  if [ -n "$F_json" ]; then
    jq -c .events "$dir/pending.json"
  else
    out=$(jq -r '.events[] | "#\(.number) \(.event)\(if (.changes | length) > 0 then " (" + (.changes | join(", ")) + ")" else "" end) from:\(.from // "-") \(.status) \"\(.subject)\" \(.url)"' "$dir/pending.json")
    echo "${out:-no new messages}"
  fi
  crashpoint commit
  if [ -z "$F_no_commit" ]; then commit_pending "$dir"; fi
}

# verify <dir>: reconciles the local delivery state with every message to you in the repo. Read-only.
verify() {
  local issues out
  issues=$(fetch_issues "$P_TO$ME" all) || die "gh failed fetching messages from $REPO"
  out=$(jq -c --arg me "$ME" --slurpfile s "$1/state.json" "$JQ_NORM"' ($s[0].versions // {}) as $v | {messages: length, problems: [.[] |
    $v[.number | tostring] as $o |
    (if $o == null then "#\(.number) never surfaced: \(.status) \"\(.subject)\" \(.url)"
     elif newer($o) then "#\(.number) update not surfaced: delivered \($o.updatedAt), now \(.updatedAt) \(.url)"
     else empty end),
    (if (.status | IN("none", "conflict", "unknown")) then "#\(.number) status labels broken (\(.status)) \(.url)"
     elif (.status | IN("open", "acknowledged")) != (.state == "open") then "#\(.number) is \(.status) but the issue is \(.state) \(.url)"
     else empty end)]}' <<<"$issues")
  if [ -n "$F_json" ]; then echo "$out"; else
    jq -r '.problems[], if (.problems | length) == 0 then "verify: \(.messages) message(s), all surfaced, states consistent"
      else "verify: \(.problems | length) problem(s) in \(.messages) message(s) (run parley-axi sync to deliver)" end' <<<"$out"
  fi
  [ "$(jq '.problems | length' <<<"$out")" = 0 ]
}

# Schedule files are local to an inbox/member; removing one never touches another timer or cron job.
schedule_paths() {
  SDIR="$STATE_DIR/schedule/$INBOX/$ME"
  UNIT="parley-axi-$INBOX:$ME"
  UDIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  TAG="# parley-axi:$INBOX:$ME"
}

schedule_lock() {
  command -v flock >/dev/null || die "flock is required for local state locking"
  mkdir -p "$STATE_DIR"
  exec 7>"$STATE_DIR/schedule.lock"
  flock 7
}

cron_read() {
  local out
  if out=$(crontab -l 2>&1); then printf '%s\n' "$out"; else
    case $out in *"no crontab for"*) ;; *) die "cannot read crontab: $out" ;; esac
  fi
}

cron_without_schedule() {
  local table
  table=$(cron_read) || return 1
  printf '%s\n' "$table" | awk -v tag="$TAG" 'substr($0, length($0) - length(tag) + 1) != tag'
}

schedule_remove() {
  [ -f "$SDIR/config.json" ] || return 0
  local backend table
  backend=$(jq -r .backend "$SDIR/config.json")
  case $backend in
    systemd)
      systemctl --user disable --now "$UNIT.timer" >/dev/null
      rm -f "$UDIR/$UNIT.timer" "$UDIR/$UNIT.service"
      systemctl --user daemon-reload >/dev/null ;;
    cron) table=$(cron_without_schedule) || return 1; printf '%s\n' "$table" | crontab - ;;
    *) die "unknown schedule backend '$backend'" ;;
  esac
  rm -f "$SDIR/config.json" "$SDIR/tick.sh"
}

cmd_schedule() {
  parse schedule "--every --notify" "$@"
  [ ${#POS[@]} -eq 1 ] || die "usage: parley-axi schedule install|status|remove|tick (see --help)"
  local action=${POS[0]} backend seconds value suffix expression="" runner active="inactive" data table
  resolve_local
  schedule_paths
  case $action in
    status)
      if [ ! -f "$SDIR/config.json" ]; then echo "schedule $INBOX as $ME: not installed"; return; fi
      backend=$(jq -r .backend "$SDIR/config.json")
      seconds=$(jq -r .seconds "$SDIR/config.json")
      case $backend in
        systemd) if systemctl --user is-active --quiet "$UNIT.timer"; then active=active; fi ;;
        cron) if cron_read | grep -qF "$TAG"; then active=active; fi ;;
      esac
      echo "schedule $INBOX as $ME: $backend every ${seconds}s ($active)" ;;
    remove) schedule_lock; schedule_remove; echo "schedule $INBOX as $ME: removed" ;;
    install)
      [ -n "$F_notify" ] || die "schedule install: --notify is required"
      [[ $F_every =~ ^([0-9]{1,9})([smhd])$ ]] || die "schedule interval must be a positive integer with s, m, h or d (e.g. 5m)"
      value=${BASH_REMATCH[1]} suffix=${BASH_REMATCH[2]}
      seconds=$((10#$value))
      case $suffix in m) seconds=$((seconds * 60)) ;; h) seconds=$((seconds * 3600)) ;; d) seconds=$((seconds * 86400)) ;; esac
      [ "$seconds" -gt 0 ] && [ "$seconds" -le 2147483647 ] || die "schedule interval is out of range"
      backend=cron
      if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then backend=systemd; fi
      if [ "$backend" = cron ]; then
        command -v crontab >/dev/null || die "neither a systemd user manager nor crontab is available"
        if [ "$seconds" -lt 3600 ] && [ $((seconds % 60)) -eq 0 ] && [ $((3600 % seconds)) -eq 0 ]; then
          expression="*/$((seconds / 60)) * * * *"
        elif [ "$seconds" -le 86400 ] && [ $((seconds % 3600)) -eq 0 ] && [ $((86400 % seconds)) -eq 0 ]; then
          if [ "$seconds" = 86400 ]; then expression="0 0 * * *"; else expression="0 */$((seconds / 3600)) * * *"; fi
        else die "cron interval must divide one hour in whole minutes, or one day in whole hours"; fi
      fi
      resolve
      schedule_lock
      if [ "$backend" = cron ]; then table=$(cron_without_schedule) || return 1; fi
      schedule_remove
      mkdir -p "$SDIR"
      # %q generates Bash arguments; the runner restores the interactive installation's environment.
      runner="$SDIR/tick.sh"
      {
        echo '#!/usr/bin/env bash'
        printf 'exec env HOME=%q XDG_CONFIG_HOME=%q XDG_STATE_HOME=%q PATH=%q %q --inbox %q --as %q schedule tick >/dev/null 2>&1\n' \
          "$HOME" "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_STATE_HOME:-$HOME/.local/state}" "$PATH" "$SELF" "$INBOX" "$ME"
      } > "$runner"
      chmod 700 "$runner"
      jq -nc --arg b "$backend" --argjson s "$seconds" --arg n "$F_notify" \
        '{backend:$b, seconds:$s, notify:$n}' > "$SDIR/config.json.tmp"
      chmod 600 "$SDIR/config.json.tmp"
      mv "$SDIR/config.json.tmp" "$SDIR/config.json"
      if [ "$backend" = systemd ]; then
        mkdir -p "$UDIR"
        data=${runner//\\/\\\\}; data=${data//\"/\\\"}; data=${data//%/%%}
        printf '[Unit]\nDescription=Parley unread notification\n[Service]\nType=oneshot\nExecStart=/bin/bash "%s"\n' "$data" > "$UDIR/$UNIT.service"
        printf '[Unit]\nDescription=Parley unread heartbeat\n[Timer]\nOnActiveSec=%ss\nOnUnitActiveSec=%ss\n[Install]\nWantedBy=timers.target\n' "$seconds" "$seconds" > "$UDIR/$UNIT.timer"
        systemctl --user daemon-reload >/dev/null
        systemctl --user enable --now "$UNIT.timer" >/dev/null
      else
        printf -v data '%q' "$runner"; data=${data//%/\\%}
        { printf '%s\n' "$table"; printf '%s /bin/bash %s >/dev/null 2>&1 %s\n' "$expression" "$data" "$TAG"; } | crontab -
      fi
      echo "schedule $INBOX as $ME: installed $backend every ${seconds}s" ;;
    tick)
      [ -f "$SDIR/config.json" ] || return 0
      # flock releases on crashes too; systemd also serializes its oneshot service.
      command -v flock >/dev/null || die "flock is required for local state locking"
      exec 9>"$SDIR/tick.lock"
      flock -n 9 || return 0
      "$SELF" --inbox "$INBOX" --as "$ME" sync --no-commit --json >/dev/null 2>&1 || return 1
      data=$("$SELF" --inbox "$INBOX" --as "$ME" list --unread --json 2>/dev/null) || return 1
      data=$(jq -r 'map("#\(.number) unread from \(.unreadFrom // "?"): \(.subject | gsub("[\\r\\n\\t]"; " "))") | join("; ")' <<<"$data")
      if [ -n "$data" ]; then
        bash -c "$(jq -r .notify "$SDIR/config.json")" <<<"$data" >/dev/null 2>&1 || return 1
      fi
      "$SELF" --inbox "$INBOX" --as "$ME" sync --commit >/dev/null 2>&1 ;;
    *) die "unknown schedule action '$action' (see parley-axi schedule --help)" ;;
  esac
}

while [ $# -gt 0 ]; do
  case $1 in
    ""|-h|--help|help) help_for main; exit 0 ;;
    --inbox|--as) [ $# -ge 2 ] || die "$1 needs a value"; printf -v "F_${1#--}" '%s' "$2"; shift 2 ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { help_for main; exit 0; }
cmd=$1; shift
case $cmd in
  init|setup|inboxes|send|list|show|reply|ack|done|decline|reopen|sync|schedule) "cmd_$cmd" "$@" ;;
  *) die "unknown command '$cmd' (see parley-axi --help)" ;;
esac
