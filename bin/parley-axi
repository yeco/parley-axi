#!/usr/bin/env bash
# parley-axi: a mail client for agents. One GitHub issue in a shared inbox repo is one message.
# The inbox repo's .parley.json names the members and the label scheme; the local config
# (XDG config dir) remembers which inboxes you use and who you are in each.
# Needs bash 3.2+, jq and an authenticated gh. Run `parley-axi --help` or `parley-axi <command> --help`.
set -euo pipefail

CONF=${XDG_CONFIG_HOME:-$HOME/.config}/parley-axi/config.json
CONFIG_FILE=.parley.json
INIT_BRANCH=parley-init
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/parley-axi
OVERLAP=${PARLEY_OVERLAP:-600}

# Defaults merged under the repo's config; jq's `*` merges nested objects.
DEFAULTS='{"labels":{"to":"to:","from":"from:","status":"status:",
  "statuses":{"open":"open","acknowledged":"acknowledged","done":"done","declined":"declined"},
  "colors":{"to":"1d76db","from":"5319e7","status":"fbca04"}}}'

die() { echo "parley-axi: $*" >&2; exit 1; }

help_for() {
  case $1 in
    init) cat <<'EOF'
usage: parley-axi init --repo <owner/name> [--member <id>[:<github-login>[:<Display Name>]]]... [--direct]
Writes a starter .parley.json to the inbox repo and creates every label it defines. Idempotent:
an existing .parley.json is kept as is, an open init PR is reused, and labels are created or updated.
Default: opens a PR from branch parley-init. --direct: commits straight to the default branch.
Without --member, the starter config has one member: your gh login.
EOF
    ;;
    setup) cat <<'EOF'
usage: parley-axi setup --repo <owner/name> --as <member-id> [--name <inbox>] [--default]
Saves an inbox to the local config after checking that you are a member and that every label exists.
--name defaults to the repo name. The first inbox you set up becomes the default; --default switches it.
EOF
    ;;
    inboxes) echo "usage: parley-axi inboxes [--json]   Lists the configured inboxes: name repo member (* marks the default)." ;;
    send) cat <<'EOF'
usage: parley-axi send --to <member-id> --subject <s> [--body <text>|--body-file <file|->] [--link <url>]... [--due YYYY-MM-DD] [--json]
Creates one issue labelled with the to, from and open-status labels. Body text comes first, then links and due date.
EOF
    ;;
    list) cat <<'EOF'
usage: parley-axi list [--all] [--sent] [--json]
Default: open messages addressed to you. --sent: messages you sent. --all: include closed ones.
Lines: #number from:<who> <status> <age> "subject" url   (--sent shows to:<who>)
--json: [{number,subject,from,to,status,state,comments,createdAt,updatedAt,url}], newest update first.
status is the lifecycle state (open, acknowledged, done, declined), or none/conflict/unknown when the labels are broken.
EOF
    ;;
    show) echo "usage: parley-axi show <n> [--json]   Prints the message header, body and comments. Sender or recipient only." ;;
    reply) echo "usage: parley-axi reply <n> <text>|-   Adds a comment. '-' reads the text from stdin. Sender or recipient only." ;;
    ack) echo "usage: parley-axi ack <n>   Recipient only. open -> acknowledged." ;;
    done) echo "usage: parley-axi done <n> [note]   Recipient only. open|acknowledged -> done, closes the issue." ;;
    decline) echo "usage: parley-axi decline <n> <reason>   Recipient only. open|acknowledged -> declined, closes the issue." ;;
    reopen) echo "usage: parley-axi reopen <n> [note]   Sender or recipient. done|declined -> open, reopens the issue." ;;
    sync) cat <<'EOT'
usage: parley-axi sync [--json] [--no-commit] | sync --commit | sync --verify [--json]
Delivers every message to you that is new or changed since the last sync (new message, new comments,
status change, edit), at least once. One line per event, or --json: [{...message, event, changes}].
--no-commit prints the events but keeps them pending; sync --commit marks them delivered. Use the pair
when something else has to show the events first, so a crash in between delivers them again.
--verify compares the local delivery state with the repo and lists any message never surfaced and any
broken status; it changes nothing and exits 1 when it finds a problem.
env: PARLEY_OVERLAP (seconds re-read before the cursor, default 600), XDG_STATE_HOME (state in $XDG_STATE_HOME/parley-axi/)
EOT
    ;;
    *) cat <<'EOF'
usage: parley-axi [--inbox <name>] [--as <member-id>] <command> [args]
commands:
  init      write a starter .parley.json to an inbox repo and create its labels
  setup     add an inbox to the local config
  inboxes   list configured inboxes
  send      send a message
  list      list messages to you (or --sent)
  show      read one message
  reply     comment on a message
  ack       acknowledge a message sent to you
  done      mark a message done and close it
  decline   decline a message and close it
  reopen    reopen a done or declined message
  sync      deliver new and changed messages, at least once (--verify to reconcile)
Every command takes --help. --inbox and --as also work after the command.
env: PARLEY_INBOX (inbox name), XDG_CONFIG_HOME (local config at $XDG_CONFIG_HOME/parley-axi/config.json)
EOF
    ;;
  esac
}

# parse <command> <allowed options> <args...>: options land in F_<name> (arrays for --link and --member),
# everything else in POS. --inbox and --as are allowed everywhere; `--` ends options.
parse() {
  local cmd=$1 allowed=" $2 --inbox --as " opt
  shift 2
  POS=()
  while [ $# -gt 0 ]; do
    case $1 in
      --) shift; POS+=("$@"); break ;;
      -h|--help) help_for "$cmd"; exit 0 ;;
      --*)
        [[ $allowed == *" $1 "* ]] || die "$cmd: unknown option '$1' (see parley-axi $cmd --help)"
        opt=${1#--}
        case $1 in
          --json|--all|--sent|--direct|--default|--verify|--no-commit|--commit) printf -v "F_${opt//-/_}" 1; shift; continue ;;
        esac
        [ $# -ge 2 ] || die "$cmd: $1 needs a value"
        case $1 in
          --link) F_link+=("$2") ;;
          --member) F_member+=("$2") ;;
          *) printf -v "F_${opt//-/_}" '%s' "$2" ;;
        esac
        shift 2
        ;;
      *) POS+=("$1"); shift ;;
    esac
  done
}
F_inbox="" F_as="" F_repo="" F_name="" F_to="" F_subject="" F_body="" F_body_file="" F_due=""
F_json="" F_all="" F_sent="" F_direct="" F_default="" F_verify="" F_no_commit="" F_commit=""
F_link=() F_member=()

require_gh() {
  command -v jq >/dev/null || die "jq is not installed"
  command -v gh >/dev/null || die "gh is not installed"
  gh auth token >/dev/null 2>&1 || die "gh is not authenticated: run 'gh auth login'"
}

check_repo() { [[ $1 =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "--repo must look like owner/name, got '$1'"; }

# fetch_config: sets RAW to the repo's .parley.json, or returns 1 when the file does not exist.
fetch_config() {
  if RAW=$(gh api -H 'Accept: application/vnd.github.raw+json' "repos/$REPO/contents/$CONFIG_FILE" 2>&1); then return 0; fi
  case $RAW in *"HTTP 404"*) return 1 ;; esac
  die "gh failed reading $REPO/$CONFIG_FILE: $RAW"
}

# use_config <json>: validates it, then sets CFG (defaults merged), the label prefixes P_* and status values S_*.
use_config() {
  local err
  CFG=$(jq -c --argjson d "$DEFAULTS" '$d * .' <<<"$1" 2>/dev/null) || die "$REPO/$CONFIG_FILE is not a JSON object"
  err=$(jq -r 'def nonempty: type == "string" and . != "";
    [ (if (.members | type) != "array" or (.members | length) == 0 then "members must be a non-empty array"
       else (.members[] | if type != "object" then "each member must be an object"
         elif (.id | type) != "string" or (.id | test("^[A-Za-z0-9._-]+$") | not) then "member id \(.id | tojson) must match [A-Za-z0-9._-]+"
         elif (.github | nonempty | not) then "member \(.id) needs a github login" else empty end),
         (.members | map(.id) | group_by(.)[] | select(length > 1) | "duplicate member id \(.[0])") end),
      (if ([.labels.to, .labels.from, .labels.status] | all(nonempty) | not) then "labels.to, labels.from and labels.status must be non-empty strings"
       elif ([.labels.to, .labels.from, .labels.status] | unique | length) != 3 then "labels.to, labels.from and labels.status must differ" else empty end),
      (if ([.labels.statuses | .open, .acknowledged, .done, .declined] | all(nonempty) | not) then "labels.statuses needs open, acknowledged, done and declined"
       elif ([.labels.statuses | .open, .acknowledged, .done, .declined] | unique | length) != 4 then "labels.statuses values must differ" else empty end)
    ] | first // empty' <<<"$CFG" 2>/dev/null) || die "$REPO/$CONFIG_FILE has an invalid shape"
  [ -z "$err" ] || die "$REPO/$CONFIG_FILE: $err"
  eval "$(jq -r '.labels | @sh "P_TO=\(.to) P_FROM=\(.from) P_ST=\(.status) S_OPEN=\(.statuses.open) S_ACK=\(.statuses.acknowledged) S_DONE=\(.statuses.done) S_DECL=\(.statuses.declined)"' <<<"$CFG")"
}

is_member() { jq -e --arg id "$1" 'any(.members[]; .id == $id)' <<<"$CFG" >/dev/null; }
member_ids() { jq -r '[.members[].id] | join(", ")' <<<"$CFG"; }

# labels_tsv: every label the config defines, as name<TAB>color<TAB>description.
labels_tsv() {
  jq -r '.labels as $l | ($l.colors | map_values(tostring | ltrimstr("#"))) as $c |
    (.members[] | [$l.to + .id, $c.to, "Message to \(.name // .id)"], [$l.from + .id, $c.from, "Message from \(.name // .id)"]),
    ($l.statuses | (.open, .acknowledged, .done, .declined) | [$l.status + ., $c.status, "Message status: \(.)"]) | @tsv' <<<"$CFG"
}

# resolve: picks the inbox (--inbox, PARLEY_INBOX, then the default), sets INBOX, REPO, ME and loads the repo config.
resolve() {
  [ -f "$CONF" ] || die "no inbox configured: run parley-axi setup --repo <owner/name> --as <member-id>"
  INBOX=${F_inbox:-${PARLEY_INBOX:-$(jq -r '.default // empty' "$CONF")}}
  [ -n "$INBOX" ] || die "no default inbox: pass --inbox <name> (see parley-axi inboxes)"
  REPO=$(jq -r --arg n "$INBOX" '.inboxes[$n].repo // empty' "$CONF")
  [ -n "$REPO" ] || die "unknown inbox '$INBOX' (see parley-axi inboxes)"
  ME=${F_as:-$(jq -r --arg n "$INBOX" '.inboxes[$n].member // empty' "$CONF")}
  require_gh
  fetch_config || die "$REPO has no $CONFIG_FILE: run parley-axi init --repo $REPO"
  use_config "$RAW"
  is_member "$ME" || die "'$ME' is not a member of $REPO (members: $(member_ids))"
}


# load <n>: sets STATE and LABELS (one per line) and checks it is a parley message.
load() {
  [[ $1 =~ ^[0-9]+$ ]] || die "message number must be numeric, got '$1'"
  local out
  out=$(gh issue view "$1" -R "$REPO" --json state,labels --jq '.state, .labels[].name' 2>&1) || case $out in
    *"Could not resolve"*|*"not found"*) die "no message #$1 in $REPO" ;;
    *) die "gh failed reading #$1: $out" ;;
  esac
  STATE=$(head -n 1 <<<"$out")
  LABELS=$(tail -n +2 <<<"$out")
  [ -n "$(label_val "$P_FROM")" ] || die "#$1 is not a parley message (no $P_FROM label)"
}

# label_val <prefix>: the rest of the first LABELS entry that starts with <prefix>.
label_val() {
  local l
  while IFS= read -r l; do
    if [[ $l == "$1"* ]]; then echo "${l#"$1"}"; return 0; fi
  done <<<"$LABELS"
}

need_party() {
  case $ME in "$(label_val "$P_TO")"|"$(label_val "$P_FROM")") ;;
    *) die "#$1 is between $(label_val "$P_FROM") and $(label_val "$P_TO"), not you ($ME)" ;;
  esac
}

need_recipient() {
  [ "$(label_val "$P_TO")" = "$ME" ] || die "#$1 is addressed to $(label_val "$P_TO"), not to you ($ME)"
}

status_label() {
  case $1 in open) echo "$P_ST$S_OPEN" ;; acknowledged) echo "$P_ST$S_ACK" ;; done) echo "$P_ST$S_DONE" ;; declined) echo "$P_ST$S_DECL" ;; esac
}

# cur_status <n>: the message's lifecycle state. The single status label is the state; open/closed follows it.
cur_status() {
  local l vals=()
  while IFS= read -r l; do
    if [[ $l == "$P_ST"* ]]; then vals+=("${l#"$P_ST"}"); fi
  done <<<"$LABELS"
  [ ${#vals[@]} -eq 1 ] || die "#$1 has ${#vals[@]} status labels: fix them by hand so exactly one remains (see parley-axi sync --verify)"
  case ${vals[0]} in
    "$S_OPEN") echo open ;; "$S_ACK") echo acknowledged ;; "$S_DONE") echo "done" ;; "$S_DECL") echo declined ;;
    *) die "#$1 has unknown status label '$P_ST${vals[0]}'" ;;
  esac
}

# set_status <n> <label>: leaves exactly one status label on the issue.
set_status() {
  local args=(--add-label "$2") l
  while IFS= read -r l; do
    if [[ $l == "$P_ST"* && $l != "$2" ]]; then args+=(--remove-label "$l"); fi
  done <<<"$LABELS"
  gh issue edit "$1" -R "$REPO" "${args[@]}" >/dev/null
}

# JQ_NORM: turns a REST issue into a message. status is the lifecycle state, or none/conflict/unknown when the labels are broken.
# shellcheck disable=SC2016 # jq variables
JQ_NORM='def lab($p): [.labels[] | select(startswith($p)) | ltrimstr($p)];
  def norm($l): ($l.statuses | to_entries | map({key: .value, value: .key}) | from_entries) as $roles |
    {number, subject: .title, from: (lab($l.from) | first), to: (lab($l.to) | first),
     status: (lab($l.status) | if length == 1 then ($roles[.[0]] // "unknown") elif length == 0 then "none" else "conflict" end),
     state, comments, createdAt: .created_at, updatedAt: .updated_at, url: .html_url};'

# fetch_issues <label> <open|closed|all> [since]: every matching message, all pages, oldest update first, as one JSON array.
fetch_issues() {
  local q
  q="labels=$(jq -rn --arg l "$1" '$l | @uri')&state=$2&sort=updated&direction=asc&per_page=100${3:+&since=$3}"
  gh api --paginate "repos/$REPO/issues?$q" \
    --jq '.[] | select(.pull_request == null) | {number, title, state, comments, created_at, updated_at, html_url, labels: [.labels[].name]}' |
    jq -cs --argjson l "$(jq -c .labels <<<"$CFG")" "$JQ_NORM map(norm(\$l))"
}

# crashpoint <step>: test hook that simulates a crash right before <step>.
crashpoint() { [ "${PARLEY_CRASH_AT:-}" != "$1" ] || exit 70; }
cmd_init() {
  parse init "--repo --member --direct" "$@"
  [ ${#POS[@]} -eq 0 ] && [ -n "$F_repo" ] || die "usage: parley-axi init --repo <owner/name> (see --help)"
  check_repo "$F_repo"
  REPO=$F_repo
  require_gh
  if fetch_config; then
    use_config "$RAW"
    echo "config: $REPO/$CONFIG_FILE exists, kept it"
  else
    local m id gh_login name members="[]" json b64 branch sha url
    if [ ${#F_member[@]} -eq 0 ]; then F_member=("$(gh api user --jq .login)"); fi
    for m in "${F_member[@]}"; do
      IFS=: read -r id gh_login name <<<"$m"
      members=$(jq -c --arg i "$id" --arg g "${gh_login:-$id}" --arg n "${name:-$id}" '. + [{id: $i, name: $n, github: $g}]' <<<"$members")
    done
    json=$(jq --argjson m "$members" --argjson d "$DEFAULTS" -n '{members: $m} + $d')
    use_config "$json"
    b64=$(printf '%s\n' "$json" | base64 | tr -d '\n')
    if [ -n "$F_direct" ]; then
      gh api -X PUT "repos/$REPO/contents/$CONFIG_FILE" -f message="chore: add parley inbox config" -f content="$b64" >/dev/null
      echo "config: committed $CONFIG_FILE to $REPO"
    elif url=$(gh pr list -R "$REPO" --head "$INIT_BRANCH" --state open --json url --jq '.[0].url // empty') && [ -n "$url" ]; then
      echo "config: init PR already open: $url (merge it, then run parley-axi setup)"
    else
      branch=$(gh api "repos/$REPO" --jq .default_branch)
      sha=$(gh api "repos/$REPO/git/ref/heads/$branch" --jq .object.sha 2>/dev/null) \
        || die "cannot read $REPO@$branch (empty repo?): rerun with --direct"
      gh api "repos/$REPO/git/refs" -f ref="refs/heads/$INIT_BRANCH" -f sha="$sha" >/dev/null 2>&1 \
        || die "cannot create branch $INIT_BRANCH in $REPO (it may already exist without an open PR): delete it or rerun with --direct"
      gh api -X PUT "repos/$REPO/contents/$CONFIG_FILE" -f message="chore: add parley inbox config" -f content="$b64" -f branch="$INIT_BRANCH" >/dev/null
      url=$(gh pr create -R "$REPO" --head "$INIT_BRANCH" --base "$branch" --title "Add parley inbox config" \
        --body "Adds $CONFIG_FILE so parley-axi can use this repo as an inbox. Edit the members before merging.")
      echo "config: opened $url (merge it, then run parley-axi setup)"
    fi
  fi
  local n=0 label color desc
  while IFS=$'\t' read -r label color desc; do
    gh label create "$label" -R "$REPO" --color "$color" --description "$desc" --force >/dev/null
    n=$((n + 1))
  done < <(labels_tsv)
  echo "labels: $n ensured in $REPO"
}

cmd_setup() {
  parse setup "--repo --name --default" "$@"
  [ ${#POS[@]} -eq 0 ] && [ -n "$F_repo" ] && [ -n "$F_as" ] || die "usage: parley-axi setup --repo <owner/name> --as <member-id> (see --help)"
  check_repo "$F_repo"
  REPO=$F_repo ME=$F_as
  local name=${F_name:-${F_repo#*/}} have missing login want
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "--name must match [A-Za-z0-9._-]+, got '$name'"
  require_gh
  fetch_config || die "$REPO has no $CONFIG_FILE: run parley-axi init --repo $REPO"
  use_config "$RAW"
  is_member "$ME" || die "'$ME' is not a member of $REPO (members: $(member_ids))"
  have=$(gh label list -R "$REPO" --limit 1000 --json name --jq '.[].name') || die "gh failed listing labels in $REPO"
  missing=$(labels_tsv | cut -f1 | grep -vxF -f <(printf '%s\n' "$have") | paste -sd' ' -) || true
  [ -z "$missing" ] || die "missing labels in $REPO: $missing (run parley-axi init --repo $REPO)"
  want=$(jq -r --arg id "$ME" '.members[] | select(.id == $id) | .github' <<<"$CFG")
  login=$(gh api user --jq .login 2>/dev/null) || login=""
  if [ -n "$login" ] && [ "$(tr '[:upper:]' '[:lower:]' <<<"$login")" != "$(tr '[:upper:]' '[:lower:]' <<<"$want")" ]; then
    echo "warning: gh is logged in as $login, but $ME is $want in $REPO" >&2
  fi
  mkdir -p "$(dirname "$CONF")"
  { cat "$CONF" 2>/dev/null || echo '{}'; } | jq --arg n "$name" --arg r "$REPO" --arg m "$ME" --arg d "$F_default" \
    '.inboxes[$n] = {repo: $r, member: $m} | if .default == null or $d == "1" then .default = $n else . end' > "$CONF.tmp"
  mv "$CONF.tmp" "$CONF"
  echo "inbox $name: $REPO as $ME$( [ "$(jq -r .default "$CONF")" = "$name" ] && echo " (default)")"
}

cmd_inboxes() {
  parse inboxes "--json" "$@"
  [ -f "$CONF" ] || { echo "no inboxes (run parley-axi setup)"; return; }
  if [ -n "$F_json" ]; then jq '.' "$CONF"; return; fi
  jq -r '.default as $d | .inboxes | to_entries[] | "\(.key)\(if .key == $d then "*" else "" end) \(.value.repo) \(.value.member)"' "$CONF"
}

cmd_send() {
  parse send "--to --subject --body --body-file --link --due --json" "$@"
  [ ${#POS[@]} -eq 0 ] || die "send: unexpected argument '${POS[0]}' (see parley-axi send --help)"
  local body=$F_body parts=() msg="" p url
  resolve
  [ -n "$F_to" ] || die "send: --to is required (members: $(member_ids))"
  is_member "$F_to" || die "send: '$F_to' is not a member of $REPO (members: $(member_ids))"
  [ -n "$F_subject" ] || die "send: --subject is required"
  if [ -n "$F_body_file" ]; then
    [ -z "$body" ] || die "send: use --body or --body-file, not both"
    if [ "$F_body_file" = - ]; then body=$(cat); else
      [ -r "$F_body_file" ] || die "send: cannot read $F_body_file"
      body=$(cat "$F_body_file")
    fi
  fi
  for p in ${F_link[@]+"${F_link[@]}"}; do
    [[ $p == http://* || $p == https://* ]] || die "send: --link must be an http(s) URL, got '$p'"
  done
  if [ -n "$F_due" ]; then
    [[ $F_due =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "send: --due must be YYYY-MM-DD, got '$F_due'"
  fi

  if [ -n "$body" ]; then parts+=("$body"); fi
  if [ ${#F_link[@]} -gt 0 ]; then parts+=("Links:"$'\n'"$(printf -- '- %s\n' "${F_link[@]}")"); fi
  if [ -n "$F_due" ]; then parts+=("Due: $F_due"); fi
  parts+=("<!-- parley-message {\"v\":1,\"from\":\"$ME\",\"to\":\"$F_to\"} -->")
  for p in "${parts[@]}"; do msg+="${msg:+$'\n\n'}$p"; done

  url=$(gh issue create -R "$REPO" --title "$F_subject" --body "$msg" \
    --label "$P_TO$F_to" --label "$P_FROM$ME" --label "$(status_label open)")
  if [ -n "$F_json" ]; then
    jq -nc --argjson n "${url##*/}" --arg u "$url" --arg t "$F_to" '{number: $n, to: $t, url: $u}'
  else
    echo "sent #${url##*/} to $F_to: $url"
  fi
}

cmd_list() {
  parse list "--all --sent --json" "$@"
  [ ${#POS[@]} -eq 0 ] || die "list: unexpected argument '${POS[0]}' (see parley-axi list --help)"
  resolve
  local state=open mine=$P_TO show=from out
  if [ -n "$F_all" ]; then state=all; fi
  if [ -n "$F_sent" ]; then mine=$P_FROM show=to; fi
  out=$(fetch_issues "$mine$ME" "$state" | jq -c reverse) || die "gh failed listing messages in $REPO"
  if [ -n "$F_json" ]; then echo "$out"; return; fi
  out=$(jq -r --arg show "$show" '
    def age: if . < 60 then "\(.)s" elif . < 3600 then "\(./60|floor)m"
             elif . < 86400 then "\(./3600|floor)h" else "\(./86400|floor)d" end;
    .[] | "#\(.number) \($show):\(.[$show] // "-") \(.status) \((now - (.createdAt | fromdateiso8601)) | floor | age) \"\(.subject)\" \(.url)"' <<<"$out")
  echo "${out:-no messages}"
}

cmd_show() {
  parse show "--json" "$@"
  [ ${#POS[@]} -eq 1 ] || die "usage: parley-axi show <n> [--json]"
  resolve
  load "${POS[0]}"
  need_party "${POS[0]}"
  local out
  out=$(gh issue view "${POS[0]}" -R "$REPO" --json number,title,body,state,labels,author,comments,createdAt,updatedAt,url)
  if [ -n "$F_json" ]; then echo "$out"; return; fi
  # Rendered here because gh's non-TTY --comments output drops the body.
  jq -r --arg to "$P_TO" --arg from "$P_FROM" --arg st "$P_ST" '
    def lab($p): [.labels[].name | select(startswith($p)) | ltrimstr($p)] | first // "-";
    def text: split("\n") | map(select(startswith("<!-- parley-") | not)) | join("\n") | sub("\\s+$"; "");
    "#\(.number) \(.title)",
    "from:\(lab($from)) to:\(lab($to)) status:\(lab($st)) \(.state | ascii_downcase) \(.createdAt) \(.url)",
    "", (.body | text | select(. != "")),
    (.comments[] | "", "--- \(.author.login) \(.createdAt)", (.body | text))' <<<"$out"
}

cmd_reply() {
  parse reply "" "$@"
  [ ${#POS[@]} -ge 2 ] || die "usage: parley-axi reply <n> <text>|-"
  local n=${POS[0]} text="${POS[*]:1}"
  resolve
  load "$n"
  need_party "$n"
  if [ "$text" = - ]; then text=$(cat); fi
  [ -n "$text" ] || die "reply text is empty"
  gh issue comment "$n" -R "$REPO" --body "$text" >/dev/null
  echo "replied on #$n"
}

# transition <ack|done|decline|reopen> <note>: one step of the message state machine (see README).
# Writes in this order: the record comment, close/reopen, then the status label. The label is the
# commit point, so after a failure the same command is still legal and rerunning it finishes the step.
transition() {
  local cmd=$1 note=$2 n=${POS[0]} cur next body out
  resolve
  load "$n"
  if [ "$cmd" = reopen ]; then need_party "$n"; else need_recipient "$n"; fi
  cur=$(cur_status "$n")
  case $cmd:$cur in
    ack:open) next=acknowledged ;;
    done:open|done:acknowledged) next="done" ;;
    decline:open|decline:acknowledged) next=declined ;;
    reopen:done|reopen:declined) next=open ;;
    *) case $cur in open) out="ack, done or decline" ;; acknowledged) out="done or decline" ;; *) out=reopen ;; esac
       die "$cmd: #$n is $cur; from $cur the allowed commands are $out" ;;
  esac
  body="parley: $cur -> $next by $ME"$'\n'"<!-- parley-transition {\"v\":1,\"from\":\"$cur\",\"to\":\"$next\",\"by\":\"$ME\"} -->"
  if [ -n "$note" ]; then body+=$'\n\n'"$note"; fi
  gh issue comment "$n" -R "$REPO" --body "$body" >/dev/null
  # gh prints its own success line on stderr, so keep stderr only when the call fails
  case $next:$STATE in
    done:OPEN|declined:OPEN) out=$(gh issue close "$n" -R "$REPO" 2>&1) || die "gh failed closing #$n: $out" ;;
    open:CLOSED) out=$(gh issue reopen "$n" -R "$REPO" 2>&1) || die "gh failed reopening #$n: $out" ;;
  esac
  set_status "$n" "$(status_label "$next")"
  echo "#$n $cur -> $next"
}

cmd_ack() {
  parse ack "" "$@"
  [ ${#POS[@]} -eq 1 ] || die "usage: parley-axi ack <n>"
  transition ack ""
}

cmd_done() {
  parse "done" "" "$@"
  [ ${#POS[@]} -ge 1 ] || die "usage: parley-axi done <n> [note]"
  transition "done" "${POS[*]:1}"
}

cmd_decline() {
  parse decline "" "$@"
  [ ${#POS[@]} -ge 2 ] || die "usage: parley-axi decline <n> <reason>"
  transition decline "${POS[*]:1}"
}

cmd_reopen() {
  parse reopen "" "$@"
  [ ${#POS[@]} -ge 1 ] || die "usage: parley-axi reopen <n> [note]"
  transition reopen "${POS[*]:1}"
}

# Delivery state per inbox, in $STATE_DIR/<inbox>/:
#   state.json    {cursor, versions: {"<n>": {updatedAt, comments, status, state}}}, the last committed delivery
#   pending.json  the next state.json plus the events it delivers, written before any event is printed
# A sync fetches every message updated since cursor minus PARLEY_OVERLAP, prints what changed, and only then
# commits. A crash at any step leaves state.json as it was, so the events come again (at least once).
commit_pending() {
  [ -f "$1/pending.json" ] || return 0
  jq -c 'del(.events)' "$1/pending.json" > "$1/state.json.tmp"
  crashpoint swap
  mv "$1/state.json.tmp" "$1/state.json"
  rm -f "$1/pending.json"
}

cmd_sync() {
  parse sync "--verify --no-commit --commit --json" "$@"
  [ ${#POS[@]} -eq 0 ] || die "sync: unexpected argument '${POS[0]}' (see parley-axi sync --help)"
  resolve
  local dir="$STATE_DIR/$INBOX" since issues out
  mkdir -p "$dir"
  [ -f "$dir/state.json" ] || echo '{}' > "$dir/state.json"
  if [ -n "$F_commit" ]; then commit_pending "$dir"; return; fi
  if [ -n "$F_verify" ]; then verify "$dir"; return; fi

  since=$(jq -r --argjson o "$OVERLAP" '.cursor // empty | fromdateiso8601 - $o | todateiso8601' "$dir/state.json")
  issues=$(fetch_issues "$P_TO$ME" all "$since") || die "gh failed fetching messages from $REPO"
  crashpoint write-pending
  # A version only moves forward, so a stale read never hides or replays an update. The first sync
  # delivers open messages only; closed ones before it are history, not news.
  jq -c --slurpfile s "$dir/state.json" '
    $s[0] as $old | ($old.versions // {}) as $v | . as $all |
    {cursor: ([$old.cursor // empty, $all[].updatedAt] | max),
     versions: (reduce $all[] as $i ($v; ($i.number | tostring) as $k |
       if .[$k] == null or $i.updatedAt > .[$k].updatedAt then .[$k] = ($i | {updatedAt, comments, status, state}) else . end)),
     events: [$all[] | . as $i | $v[.number | tostring] as $o |
       select(if $o == null then ($old.cursor != null or .state == "open") else .updatedAt > $o.updatedAt end) |
       . + {event: (if $o == null then "new" else "updated" end),
            changes: (if $o == null then [] else
              [(if .comments > $o.comments then "+\(.comments - $o.comments) comment(s)" else empty end),
               (if .status != $o.status then "\($o.status) -> \(.status)" else empty end),
               (if .state != $o.state then .state else empty end)] | if length == 0 then ["edited"] else . end end)}]}' \
    <<<"$issues" > "$dir/pending.json.tmp"
  mv "$dir/pending.json.tmp" "$dir/pending.json"
  crashpoint emit
  if [ -n "$F_json" ]; then
    jq -c .events "$dir/pending.json"
  else
    out=$(jq -r '.events[] | "#\(.number) \(.event)\(if (.changes | length) > 0 then " (" + (.changes | join(", ")) + ")" else "" end) from:\(.from // "-") \(.status) \"\(.subject)\" \(.url)"' "$dir/pending.json")
    echo "${out:-no new messages}"
  fi
  crashpoint commit
  if [ -z "$F_no_commit" ]; then commit_pending "$dir"; fi
}

# verify <dir>: reconciles the local delivery state with every message to you in the repo. Read-only.
verify() {
  local issues out
  issues=$(fetch_issues "$P_TO$ME" all) || die "gh failed fetching messages from $REPO"
  out=$(jq -c --slurpfile s "$1/state.json" '($s[0].versions // {}) as $v | {messages: length, problems: [.[] |
    $v[.number | tostring] as $o |
    (if $o == null then "#\(.number) never surfaced: \(.status) \"\(.subject)\" \(.url)"
     elif .updatedAt > $o.updatedAt then "#\(.number) update not surfaced: delivered \($o.updatedAt), now \(.updatedAt) \(.url)"
     else empty end),
    (if (.status | IN("none", "conflict", "unknown")) then "#\(.number) status labels broken (\(.status)) \(.url)"
     elif (.status | IN("open", "acknowledged")) != (.state == "open") then "#\(.number) is \(.status) but the issue is \(.state) \(.url)"
     else empty end)]}' <<<"$issues")
  if [ -n "$F_json" ]; then echo "$out"; else
    jq -r '.problems[], if (.problems | length) == 0 then "verify: \(.messages) message(s), all surfaced, states consistent"
      else "verify: \(.problems | length) problem(s) in \(.messages) message(s) (run parley-axi sync to deliver)" end' <<<"$out"
  fi
  [ "$(jq '.problems | length' <<<"$out")" = 0 ]
}

while [ $# -gt 0 ]; do
  case $1 in
    ""|-h|--help|help) help_for main; exit 0 ;;
    --inbox|--as) [ $# -ge 2 ] || die "$1 needs a value"; printf -v "F_${1#--}" '%s' "$2"; shift 2 ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { help_for main; exit 0; }
cmd=$1; shift
case $cmd in
  init|setup|inboxes|send|list|show|reply|ack|done|decline|reopen|sync) "cmd_$cmd" "$@" ;;
  *) die "unknown command '$cmd' (see parley-axi --help)" ;;
esac
