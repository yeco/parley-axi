#!/usr/bin/env bash
# Fake gh for tests. Logs every call to $STUB_LOG and serves files from $STUB_DIR, keyed by repo slug (owner__name):
#   <slug>.parley.json (contents API), <slug>.labels (one per line), <slug>.pr (open init PR url),
#   <slug>.issues.json (REST issues: filtered by labels, state and since, in pages of 100; only the first without --paginate), <slug>.issue-<n>.json (view).
# STUB_NO_AUTH and STUB_GH_FAIL simulate a logged-out gh and a network failure.
set -o pipefail
printf '%s\n' "$*" >> "$STUB_LOG"
[ -z "${STUB_GH_FAIL:-}" ] || { echo "error connecting to api.github.com" >&2; exit 1; }
repo="" jqf="" path="" fields=()
args=("$@")
for ((i = 0; i < $#; i++)); do
  case ${args[i]} in
    -R) repo=${args[i + 1]} ;;
    --jq) jqf=${args[i + 1]} ;;
    -f|-F) fields+=("${args[i + 1]}") ;;
    repos/*) path=${args[i]}; repo=$(cut -d/ -f2-3 <<<"$path") ;;
  esac
done
slug=${repo/\//__}
emit() { if [ -n "$jqf" ]; then jq -r "$jqf"; else cat; fi; }
field() { local f; for f in ${fields[@]+"${fields[@]}"}; do [[ $f == "$1="* ]] && echo "${f#*=}"; done; }
touch_issue() {
  local f="$STUB_DIR/$slug.issue-$3.json" t seconds=1
  [ -f "$f" ] || return 0
  t=$(mktemp "$f.XXXXXX")
  if [ -n "${STUB_SAME_SECOND:-}" ]; then seconds=0; fi
  jq --argjson seconds "$seconds" '.updatedAt = ((.updatedAt // "2026-11-05T10:00:00Z" | fromdateiso8601) + $seconds | todateiso8601)' "$f" > "$t" && mv "$t" "$f"
  if [ -f "$STUB_DIR/$slug.issues.json" ]; then
    t=$(mktemp "$STUB_DIR/$slug.issues.json.XXXXXX")
    jq --argjson n "$3" --slurpfile issue "$f" 'map(if .number == $n then
      .updated_at = $issue[0].updatedAt | .body = ($issue[0].body // "") | .title = $issue[0].title | .comments = ($issue[0].comments // [] | length) |
      .state = ($issue[0].state | ascii_downcase) | .labels = $issue[0].labels
      else . end)' "$STUB_DIR/$slug.issues.json" > "$t" && mv "$t" "$STUB_DIR/$slug.issues.json"
  fi
}
case "$1 $2" in
  "auth token") [ -z "${STUB_NO_AUTH:-}" ] || exit 1; echo tok ;;
  "api user") echo '{"login":"'"${STUB_LOGIN:-alice-gh}"'"}' | emit ;;
  api\ *)
    case $path in
      "")
        if [[ " $* " != *" graphql "* ]]; then exit 2; fi
        owner=$(field owner); name=$(field name); n=$(field number)
        query=$(field query)
        repo="$owner/$name"; slug=${repo/\//__}
        f="$STUB_DIR/$slug.issue-$n.json"
        if [ ! -f "$f" ]; then echo "missing issue $n" >&2; exit 1; fi
        view=$(jq --arg id "issue-$slug-$n" --argjson n "$n" '.id //= $id | .number //= $n |
          .author //= {login:"bob-gh"} | .body //= "" | .title //= "Message" |
          .createdAt //= "2026-11-05T10:00:00Z" | .updatedAt //= .createdAt | .url //= "https://x" |
          .comments //= [] | .comments |= (to_entries | map(.value + {id:(.value.id // ($id + "-comment-" + (.key|tostring)))}))' "$f")
        if [[ $query == *timelineItems* ]]; then
          if [ -n "${STUB_TIMELINE_RACE:-}${STUB_TIMELINE_STALE:-}" ]; then
            count=$(cat "$STUB_DIR/timeline-count" 2>/dev/null || echo 0)
            count=$((count + 1))
            echo "$count" > "$STUB_DIR/timeline-count"
            if [[ ${STUB_TIMELINE_RACE:-}:$count == before-first:1 || ${STUB_TIMELINE_RACE:-}:$count == after-first:1 || ${STUB_TIMELINE_RACE:-}:$count == after-second:2 ]]; then
              jq --arg actor "${STUB_RACE_ACTOR:-bob-gh}" '
                .state = "CLOSED" | .timeline += [{id:"timeline-close", __typename:"ClosedEvent", actor:{login:$actor}}]' \
                "$f" > "$f.tmp" && mv "$f.tmp" "$f"
              touch_issue issue close "$n"
              if [ "$STUB_TIMELINE_RACE" = before-first ]; then view=$(cat "$f"); fi
            fi
            if [ "${STUB_TIMELINE_STALE:-}" = 1 ] || { [ "${STUB_TIMELINE_STALE:-}" = after-first ] && [ "$count" -gt 1 ]; }; then
              view=$(jq '.updatedAt |= (fromdateiso8601 - 1 | todateiso8601) | .timeline = []' <<<"$view")
            fi
          fi
          jq --arg query "$query" '{data:{repository:{issue:{updatedAt:.updatedAt,timelineItems:{nodes:[(.timeline // [])[] |
            select(.__typename != "RenamedTitleEvent" or ($query | contains("RENAMED_TITLE_EVENT")))]}}}}}' <<<"$view" | emit
        elif [[ $query == *"id number title body"* ]]; then
          jq '{data:{repository:{issue:(del(.comments, .edits, .timeline) | . + {labels:{nodes:.labels}})}}}' <<<"$view" | emit
        else
          jq '{data:{repository:{issue:{comments:{nodes:[.comments[]? | del(.edits)]}}}}}' <<<"$view" | emit
        fi ;;
      */contents/.parley.json)
        if [[ " $* " == *" -X PUT "* ]]; then
          field content | base64 -d > "$STUB_DIR/$slug.put.json"
          echo '{}'
        elif [ -f "$STUB_DIR/$slug.parley.json" ]; then
          cat "$STUB_DIR/$slug.parley.json"
        else
          echo '{"message":"Not Found","status":"404"}'; echo "gh: Not Found (HTTP 404)" >&2; exit 1
        fi ;;
      */issues\?*)
        q=${path#*\?} label="" state="" since=""
        IFS='&' read -ra kv <<<"$q"
        for p in "${kv[@]}"; do
          v=${p#*=}; v=$(printf '%b' "${v//%/\\x}")
          case $p in labels=*) label=$v ;; state=*) state=$v ;; since=*) since=$v ;; esac
        done
        jq -c --arg l "$label" --arg s "$state" --arg t "$since" '
          map(select(($l == "" or any(.labels[]; .name == $l)) and ($s == "all" or .state == $s) and ($t == "" or .updated_at >= $t)))
          | sort_by(.updated_at) | if length == 0 then [] else range(0; length; 100) as $i | .[$i:$i + 100] end' \
          "$STUB_DIR/$slug.issues.json" | if [[ " $* " == *" --paginate "* ]]; then cat; else head -n 1; fi | emit ;;
      */git/ref/heads/*) echo '{"object":{"sha":"abc123"}}' | emit ;;
      */git/refs) echo '{}' ;;
      repos/*/*) echo '{"default_branch":"main"}' | emit ;;
      *) echo "stub gh: unhandled api: $*" >&2; exit 2 ;;
    esac ;;
  "label list") jq -Rn '[inputs | {name: .}]' "$STUB_DIR/$slug.labels" 2>/dev/null | emit ;;
  "label create") grep -qxF "$3" "$STUB_DIR/$slug.labels" 2>/dev/null || echo "$3" >> "$STUB_DIR/$slug.labels" ;;
  "pr list") jq -Rn '[inputs | {url: .}]' "$STUB_DIR/$slug.pr" 2>/dev/null | emit ;;
  "pr create") echo "https://github.com/$repo/pull/1" | tee "$STUB_DIR/$slug.pr" ;;
  "issue create") echo "https://github.com/$repo/issues/42" ;;
  "issue view")
    f="$STUB_DIR/$slug.issue-$3.json"
    [ -f "$f" ] || { echo "GraphQL: Could not resolve to an Issue with the number of $3." >&2; exit 1; }
    t=$(mktemp "$f.XXXXXX")
    jq --arg id "issue-$slug-$3" --argjson n "$3" '.id //= $id | .number //= $n |
      .author //= {login:"bob-gh"} | .body //= "" | .title //= "Message" |
      .createdAt //= "2026-11-05T10:00:00Z" | .updatedAt //= .createdAt | .url //= "https://x" |
      .comments //= [] | .comments |= (to_entries | map(.value + {id:(.value.id // ($id + "-comment-" + (.key|tostring)))}))' "$f" > "$t"
    mv "$t" "$f"
    emit < "$f" ;;
  "issue edit")
    [ -z "${STUB_EDIT_FAIL:-}" ] || { echo "label edit failed" >&2; exit 1; }
    f="$STUB_DIR/$slug.issue-$3.json"
    add='[]' remove='[]'
    for ((i = 0; i < $#; i++)); do
      case ${args[i]} in
        --add-label) add=$(jq -nc --argjson a "$add" --arg l "${args[i + 1]}" '$a + [$l]') ;;
        --remove-label) remove=$(jq -nc --argjson a "$remove" --arg l "${args[i + 1]}" '$a + [$l]') ;;
      esac
    done
    if [ -f "$f" ]; then
      jq --argjson a "$add" --argjson r "$remove" '.labels = (([.labels[].name] + $a | unique) - $r | map({name:.}))' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
      jq --argjson a "$add" --argjson r "$remove" --arg actor "${STUB_LOGIN:-alice-gh}" --arg id "label-$RANDOM-$RANDOM" \
        '.timeline = ((.timeline // []) + [($a + $r)[] | select(startswith("status:") or startswith("state/")) |
          {id:($id + .),__typename:"LabeledEvent",actor:{login:$actor},label:{name:.}}])' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
      if [ -n "${STUB_READ_RACE:-}" ] && [ "$remove" != '[]' ]; then
        jq --arg actor "${STUB_RACE_ACTOR:-alice-gh}" '.comments += [{id:"race-comment", author:{login:$actor}, createdAt:"2026-11-05T12:00:00Z", body:"A concurrent update"}]' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
        touch_issue "$@"
      fi
    fi
    if [ -n "${STUB_TOUCH_LABELS:-}" ]; then touch_issue "$@"; fi
    if [ -f "$STUB_DIR/$slug.issues.json" ]; then
      jq --argjson n "$3" --argjson a "$add" --argjson r "$remove" 'map(if .number == $n then
        .labels = (([.labels[].name] + $a | unique) - $r | map({name:.})) else . end)' \
        "$STUB_DIR/$slug.issues.json" > "$STUB_DIR/$slug.issues.json.tmp" && mv "$STUB_DIR/$slug.issues.json.tmp" "$STUB_DIR/$slug.issues.json"
    fi ;;
  "issue comment")
    f="$STUB_DIR/$slug.issue-$3.json"
    body=""
    for ((i = 0; i < $#; i++)); do
      if [ "${args[i]}" = --body ]; then body=${args[i + 1]}; fi
    done
    if [ -f "$f" ]; then
      jq --arg body "$body" --arg actor "${STUB_LOGIN:-alice-gh}" --arg id "comment-$RANDOM-$RANDOM" \
        '.comments = ((.comments // []) + [{id:$id,body:$body,author:{login:$actor},createdAt:"2026-11-05T12:00:00Z"}])' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
      touch_issue "$@"
    fi ;;
  "issue close"|"issue reopen")
    f="$STUB_DIR/$slug.issue-$3.json"
    state=OPEN; event=ReopenedEvent
    if [ "$2" = close ]; then state=CLOSED; event=ClosedEvent; fi
    if [ -f "$f" ]; then
      jq --arg state "$state" --arg event "$event" --arg actor "${STUB_LOGIN:-alice-gh}" --arg id "event-$RANDOM-$RANDOM" \
        '.state = $state | .timeline = ((.timeline // []) + [{id:$id,__typename:$event,actor:{login:$actor}}])' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
      touch_issue "$@"
    fi ;;
  *) echo "stub gh: unhandled: $*" >&2; exit 2 ;;
esac
